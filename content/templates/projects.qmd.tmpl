---
pagetitle: "{{page.title|yaml}}"
description-meta: "{{page.description|yaml}}"
toc: false
page-layout: custom
body-classes: sv-page
---

```{=html}
<div class="sv v-projects">

  <div class="top">
    <div class="tt">
      <span class="eyebrow">{{eyebrow}}</span>
      <h1 class="page-title">{{title}}</h1>
    </div>
    <ul class="rail" aria-label="On this page" style="grid-column:auto">
      {{#rail}}<li>{{.}}</li>{{/rail}}
    </ul>
  </div>

  <div class="bs">
    <div class="board one" data-stage="stage-pj" aria-label="Projects, pick one to show it">{{#projects}}
      <button class="tile" type="button" data-item="{{id}}" aria-pressed="{{#@first}}true{{/@first}}{{^@first}}false{{/@first}}">
        {{tile_mark|raw}}
        <span class="tt"><span class="name">{{name}}</span><span class="status {{kind}}">{{status}}</span></span>
      </button>{{/projects}}
    </div>

    <div class="stage" id="stage-pj">{{#projects}}{{^@first}}
{{/@first}}
      <article class="panel rail-top" data-item="{{id}}" aria-label="{{name|attr}}{{#building}}, {{status|lower1|attr}}{{/building}}">
        {{media|raw}}
        <div class="info">
          <div class="head"><h2>{{name}}</h2><span class="status {{kind}}">{{status}}</span></div>{{#has_stats}}
          <ul class="stats">{{#stats}}
            <li class="stat"><span class="n">{{n}}</span><span class="l">{{l}}</span></li>{{/stats}}
          </ul>{{/has_stats}}{{#has_buttons}}
          <div class="foot">
            <ul class="tray slim" aria-label="{{methods_label|attr}}">{{#methods}}<li>{{.}}</li>{{/methods}}</ul>
            <div class="btn-row">{{#notes}}<button class="btn" type="button" popovertarget="n-{{id}}">{{button}}</button>{{/notes}}{{#link.href}}<a class="btn primary" href="{{link.href|attr}}">{{link.label}}</a>{{/link.href}}</div>
          </div>{{/has_buttons}}{{^has_buttons}}
          <div class="foot"><ul class="tray slim" aria-label="{{methods_label|attr}}">{{#methods}}<li>{{.}}</li>{{/methods}}</ul></div>{{/has_buttons}}
        </div>
      </article>{{/projects}}
    </div>
  </div>
</div>
{{#projects}}{{#notes}}
<div id="n-{{id}}" popover class="note">
  <h3>{{title}}</h3>
{{body|note}}
  {{#has_links}}<div class="btn-row">{{#links}}<a class="btn{{#@first}} primary{{/@first}}" href="{{href|attr}}">{{label}}</a>{{/links}}<button class="btn" popovertarget="n-{{id}}" popovertargetaction="hide">Close</button></div>{{/has_links}}{{^has_links}}<button class="btn" popovertarget="n-{{id}}" popovertargetaction="hide">Close</button>{{/has_links}}
</div>{{/notes}}{{/projects}}

<script src="assets/sv.js"></script>
```
